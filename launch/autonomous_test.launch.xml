<launch>
    <!-- Include Nav2 and existing Real setup -->
    <include file="$(find-pkg-share robot_2_gps_description)/launch/robot_2_real.launch.xml" />
    
    <!-- Vision Perception Node -->
    <node pkg="robot_2_gps_description" exec="vision_perception.py" name="vision_perception_node" output="screen" />
    
    <!-- RSCP Client Node (Seri port dışarıdan parametre olarak verilebilir) -->
    <arg name="serial_port" default="/dev/ttyUSB0" />
    <node pkg="robot_2_gps_description" exec="rscp_client.py" name="rscp_client" output="screen">
        <param name="serial_port" value="$(var serial_port)" />
    </node>
    
    <!-- Test Autonomous Mission Controller Node -->
    <node pkg="robot_2_gps_description" exec="autonomous_mission_test.py" name="autonomous_mission_test" output="screen">
    </node>

    <!-- Peak Height Calculator Node -->
    <node pkg="robot_2_gps_description" exec="height.py" name="peak_height_calculator" output="screen" />
</launch>
