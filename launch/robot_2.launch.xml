<launch>

  <let name="pkg_simulation" value="$(find-pkg-share robot_2_description)"/> 
  
  <let name="urdf_path" value="$(var pkg_simulation)/urdf/robot_2.urdf.xacro"/>
  <let name="world_path" value="$(var pkg_simulation)/worlds/moon.world"/>
  <!-- $(var pkg_simulation)/worlds/moon.world -->
  <!-- <let name="model_path" value="$(var pkg_simulation)/models"/> -->

<set_env name="GAZEBO_MODEL_PATH"
         value="/home/zanyar/ros2_ws/src/Rover_simulation/models"/>
<!-- 
  <node pkg="tf2_ros" exec="static_transform_publisher" name="base_link_to_zed" 
      args="0 0.49 0.6 1.57 0 0 base_link zed2_camera_center"/> -->

<node pkg="robot_state_publisher" exec="robot_state_publisher" output="screen">
  <param name="use_sim_time" value="true"/>
  <param name="robot_description" value="$(command 'xacro $(var urdf_path)')"/>
</node>

  <arg name="params_file" default="$(var pkg_simulation)/config/nav2_params.yaml"/>
  <arg name="use_sim_time" default="true"/>

  <include file="$(find-pkg-share nav2_bringup)/launch/navigation_launch.py">
    <arg name="use_sim_time" value="$(var use_sim_time)"/>
    <arg name="params_file" value="$(var params_file)"/>
  </include>

<include file="$(find-pkg-share rtabmap_launch)/launch/rtabmap.launch.py">
    <arg name="use_sim_time" value="true"/>
    <arg name="frame_id" value="base_footprint"/>
    
    <arg name="rgb_topic" value="/zed2/zed2_sensor/image_raw"/>
    <arg name="depth_topic" value="/zed2/zed2_sensor/depth/image_raw"/>
    <arg name="camera_info_topic" value="/zed2/zed2_sensor/camera_info"/>
    <arg name="approx_sync" value="true"/>
    
    <arg name="visual_odometry" value="false"/> 
    <arg name="publish_tf_odom" value="false"/> 
    <arg name="subscribe_odom" value="true"/>   
    <arg name="odom_topic" value="/odom"/>      
    <arg name="odom_frame_id" value="odom"/>
    <arg name="publish_tf_map" value="true"/>
    <arg name="args" value="-d"/>
</include>
  <executable
    cmd="gazebo --verbose -s libgazebo_ros_init.so -s libgazebo_ros_factory.so $(var world_path)"
    output="screen"/>


  <node pkg="gazebo_ros" exec="spawn_entity.py"
        args="-topic robot_description -entity robot_2 -x 0 -y 0 -z 2"
        output="screen"/>

  <node pkg="controller_manager" exec="spawner" args="joint_state_broadcaster" output="screen"/>
  <node pkg="controller_manager" exec="spawner" args="wheel_velocity_controller" output="screen"/>
  <node pkg="controller_manager" exec="spawner" args="steer_position_controller" output="screen"/>

  <node pkg="joy" exec="joy_node"/>
  <node pkg="robot_2_description" exec="input_processor1.py"/>
  <node pkg="robot_2_description" exec="publisher.py"/>
  <node pkg="robot_2_description" exec="odom_tf.py"/>


  <let name="config_rviz"
     value="$(find-pkg-share robot_2_description)/config/rviz_config.rviz"/>

<node pkg="rviz2"
      exec="rviz2"
      args="-d $(var config_rviz)"
      output="screen">
  <param name="use_sim_time" value="true"/>
</node>

</launch>